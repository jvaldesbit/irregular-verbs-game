---
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';
---

<Layout title="alunas.co">
  <div class="page">
    <nav class="navbar">
      <div class="navbar-brand">
        <img src="/logo.svg" alt="alunas" class="navbar-logo" />
        <span class="navbar-name">alunas</span>
      </div>
      <button class="topic-chip" id="topicChip" data-i18n-title="home.topic_change" title="Change topic">
        <Icon name="books" weight="bold" size={15} />
        <span id="topicName">Verbos Irregulares</span>
        <svg class="chip-chevron" width="10" height="10" viewBox="0 0 10 10" fill="none"><path d="M2 3.5L5 6.5L8 3.5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
      </button>
    </nav>

    <div class="hero">
      <div class="hero-icon" id="topicIcon">🎮</div>
      <h1 id="topicTitle">Irregular Verbs</h1>
      <button class="install-btn" id="installBtn" style="display:none">
        <svg width="16" height="16" viewBox="0 0 16 16" fill="none"><path d="M8 2v8M5 7l3 3 3-3M3 12h10" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
        <span data-i18n="home.install">Install app</span>
      </button>
    </div>

    <!-- iOS install instructions sheet -->
    <div class="ios-sheet" id="iosSheet" style="display:none" aria-hidden="true">
      <div class="ios-sheet-inner">
        <button class="ios-sheet-close" id="iosSheetClose" aria-label="Close">✕</button>
        <p class="ios-sheet-title" data-i18n="home.install_ios_title">Add to Home Screen</p>
        <ol class="ios-steps">
          <li><span class="ios-step-icon">⬆️</span> <span data-i18n-html="home.install_ios_1">Tap the <strong>Share</strong> button at the bottom of Safari</span></li>
          <li><span class="ios-step-icon">➕</span> <span data-i18n-html="home.install_ios_2">Tap <strong>Add to Home Screen</strong></span></li>
          <li><span class="ios-step-icon">✅</span> <span data-i18n-html="home.install_ios_3">Tap <strong>Add</strong> to confirm</span></li>
        </ol>
      </div>
    </div>

    <main class="grid">
      <a href="/quick-match" class="card card--purple">
        <span class="card-icon"><Icon name="target" weight="bold" size={36} /></span>
        <h2 data-i18n="home.quick_match">Quick Match</h2>
        <p data-i18n="home.quick_match_desc">Multiple choice</p>
      </a>

      <a href="/speed-challenge" class="card card--pink">
        <span class="card-icon"><Icon name="lightning" weight="bold" size={36} /></span>
        <h2 data-i18n="home.speed_challenge">Speed Challenge</h2>
        <p data-i18n="home.speed_challenge_desc">Race the clock</p>
      </a>

      <a href="/type-master" class="card card--indigo">
        <span class="card-icon"><Icon name="keyboard" weight="bold" size={36} /></span>
        <h2 data-i18n="home.type_master">Type Master</h2>
        <p data-i18n="home.type_master_desc">Type the answer</p>
      </a>

      <a href="/memory-cards" class="card card--cyan">
        <span class="card-icon"><Icon name="cards" weight="bold" size={36} /></span>
        <h2 data-i18n="home.memory_cards">Memory Cards</h2>
        <p data-i18n="home.memory_cards_desc">Find the pairs</p>
      </a>

      <a href="/practice" class="card card--green">
        <span class="card-icon"><Icon name="infinity" weight="bold" size={36} /></span>
        <h2 data-i18n="home.practice">Practice</h2>
        <p data-i18n="home.practice_desc">At your own pace</p>
      </a>

      <a href="/scores" class="card card--gold">
        <span class="card-icon"><Icon name="trophy" weight="bold" size={36} /></span>
        <h2 data-i18n="home.records">Records</h2>
        <p data-i18n="home.records_desc">Your best scores</p>
      </a>

      <a href="/universe" class="card card--universe" id="universeCard">
        <span class="card-icon"><Icon name="globe" weight="bold" size={36} /></span>
        <h2 data-i18n="home.universes">Universes</h2>
        <p data-i18n="home.universes_desc">Compete with your class</p>
        <span class="universe-badge" id="universeBadge" style="display:none"></span>
      </a>
    </main>
  </div>
</Layout>

<style>
  .page {
    min-height: 100dvh;
    background: linear-gradient(145deg, #0a0f24 0%, #0f1730 100%);
    display: flex;
    flex-direction: column;
    align-items: center;
    padding-bottom: 5rem;
    gap: 2rem;
  }

  /* ── Navbar ───────────────────────────────────────────────────────────────── */
  .navbar {
    width: 100%;
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: calc(env(safe-area-inset-top) + 0.7rem) 1.25rem 0.7rem;
    background: rgba(255,255,255,0.06);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    border-bottom: 1px solid rgba(255,255,255,0.1);
    position: sticky;
    top: 0;
    z-index: 100;
    box-sizing: border-box;
  }

  .navbar-brand {
    display: flex;
    align-items: center;
    gap: 0.55rem;
    flex-shrink: 0;
  }

  .navbar-logo {
    height: 28px;
    width: auto;
    display: block;
  }

  .navbar-name {
    font-size: 1.25rem;
    font-weight: 900;
    letter-spacing: -0.04em;
    color: white;
    line-height: 1;
    display: none;
  }

  .topic-chip {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.4rem 0.75rem 0.4rem 0.65rem;
    background: rgba(255,255,255,0.12);
    border: 1.5px solid rgba(255,255,255,0.25);
    border-radius: 99px;
    color: rgba(255,255,255,0.9);
    font-family: var(--font);
    font-size: 0.8rem;
    font-weight: 700;
    cursor: pointer;
    transition: background var(--t), border-color var(--t);
    flex: 1;
    min-width: 0;
    justify-content: space-between;
  }

  .topic-chip:hover {
    background: rgba(255,255,255,0.2);
    border-color: rgba(255,255,255,0.45);
    color: white;
  }

  .topic-chip span {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .chip-chevron {
    flex-shrink: 0;
    opacity: 0.7;
  }

  /* ── Hero ─────────────────────────────────────────────────────────────────── */
  .hero {
    text-align: center;
    color: white;
    padding: 1.5rem 1.5rem 0;
  }

  .hero-icon {
    font-size: 3.5rem;
    line-height: 1;
    margin-bottom: 0.6rem;
  }

  h1 {
    font-size: 2.4rem;
    font-weight: 900;
    letter-spacing: -0.03em;
    text-shadow: 0 2px 12px rgba(0,0,0,0.2);
  }

  .install-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    margin-top: 0.9rem;
    padding: 0.5rem 1.1rem;
    background: rgba(0,240,255,0.12);
    border: 1.5px solid rgba(0,240,255,0.35);
    border-radius: 99px;
    color: #00f0ff;
    font-family: var(--font);
    font-size: 0.82rem;
    font-weight: 700;
    cursor: pointer;
    transition: background var(--t), border-color var(--t), transform var(--t);
  }

  .install-btn:hover {
    background: rgba(0,240,255,0.22);
    border-color: rgba(0,240,255,0.65);
    transform: translateY(-2px);
  }

  /* iOS instructions sheet */
  .ios-sheet {
    position: fixed;
    inset: 0;
    z-index: 300;
    background: rgba(10,15,36,0.7);
    backdrop-filter: blur(6px);
    display: flex;
    align-items: flex-end;
    justify-content: center;
  }

  .ios-sheet-inner {
    width: 100%;
    max-width: 480px;
    background: #0f1730;
    border: 1px solid rgba(0,240,255,0.2);
    border-radius: var(--r-xl) var(--r-xl) 0 0;
    padding: 1.5rem 1.5rem calc(env(safe-area-inset-bottom) + 1.5rem);
    position: relative;
  }

  .ios-sheet-close {
    position: absolute;
    top: 1rem;
    right: 1rem;
    background: rgba(255,255,255,0.1);
    border: none;
    border-radius: 99px;
    color: rgba(255,255,255,0.7);
    font-size: 0.8rem;
    width: 28px;
    height: 28px;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ios-sheet-title {
    font-size: 1.1rem;
    font-weight: 900;
    color: white;
    margin-bottom: 1.25rem;
  }

  .ios-steps {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .ios-steps li {
    display: flex;
    align-items: flex-start;
    gap: 0.75rem;
    font-size: 0.92rem;
    color: rgba(255,255,255,0.85);
    line-height: 1.5;
  }

  .ios-step-icon { font-size: 1.1rem; flex-shrink: 0; }
  .ios-steps strong { color: white; font-weight: 800; }

  /* Topic picker modal — :global() needed because element is created dynamically in JS */
  :global(.topic-modal-backdrop) {
    position: fixed; inset: 0; z-index: 200;
    background: rgba(15,12,41,0.72);
    backdrop-filter: blur(6px);
    display: flex; align-items: center; justify-content: center;
    padding: 1.5rem;
  }
  :global(.topic-modal) {
    background: var(--dark2); border-radius: var(--r-xl);
    border: 1px solid rgba(0,240,255,0.15);
    padding: 1.75rem 1.5rem 1.5rem;
    width: 100%; max-width: 420px;
    display: flex; flex-direction: column; gap: 1rem;
    box-shadow: var(--sh-lg);
  }
  :global(.topic-modal h3) {
    font-size: 1.15rem; font-weight: 900; color: #ffffff; letter-spacing: -0.02em;
  }
  :global(.topic-list) { display: flex; flex-direction: column; gap: 0.5rem; }
  :global(.topic-option) {
    display: flex; align-items: center; gap: 0.85rem;
    padding: 0.9rem 1rem;
    border: 2px solid rgba(255,255,255,0.08); border-radius: var(--r-md);
    cursor: pointer; background: var(--dark3);
    transition: all var(--t); text-align: left;
    font-family: var(--font);
  }
  :global(.topic-option:hover) { border-color: rgba(0,240,255,0.45); background: rgba(0,240,255,0.06); }
  :global(.topic-option.active) { border-color: var(--cyan); background: rgba(0,240,255,0.08); }
  :global(.topic-icon) { font-size: 1.5rem; line-height: 1; }
  :global(.topic-info strong) { display: block; font-size: 0.95rem; font-weight: 800; color: #ffffff; }
  :global(.topic-info small)  { font-size: 0.78rem; color: var(--muted); }
  :global(.topic-modal-close) {
    align-self: flex-end; padding: 0.4rem 0.9rem;
    background: rgba(255,255,255,0.1); border: none; border-radius: var(--r-sm);
    font-family: var(--font); font-size: 0.85rem; font-weight: 700;
    color: var(--text); cursor: pointer; transition: background var(--t);
  }
  :global(.topic-modal-close:hover) { background: rgba(255,255,255,0.18); }
  :global(.topic-modal-loading) { text-align: center; color: var(--muted); font-size: 0.9rem; padding: 1rem 0; }
  :global(.topic-modal-head) { display: flex; align-items: center; justify-content: space-between; gap: 0.5rem; }
  :global(.topic-modal-new) {
    font-size: 0.78rem; font-weight: 800; color: #00f0ff;
    background: rgba(0,240,255,0.1); border: 1px solid rgba(0,240,255,0.25);
    border-radius: 99px; padding: 0.3rem 0.75rem; text-decoration: none;
    white-space: nowrap; transition: background var(--t);
  }
  :global(.topic-modal-new:hover) { background: rgba(0,240,255,0.2); }
  :global(.topic-section-label) {
    font-size: 0.68rem; font-weight: 700; text-transform: uppercase;
    letter-spacing: 0.09em; color: var(--muted); padding: 0.5rem 0.25rem 0.25rem;
  }
  :global(.topic-local-badge) { font-size: 0.9rem; flex-shrink: 0; }
  :global(.topic-row) { display: flex; align-items: center; gap: 0.4rem; }
  :global(.topic-row .topic-option) { flex: 1; }
  :global(.topic-delete-btn) {
    flex-shrink: 0;
    width: 2rem; height: 2rem;
    display: flex; align-items: center; justify-content: center;
    background: rgba(239,68,68,0.12); border: 1px solid rgba(239,68,68,0.25);
    border-radius: var(--r-sm);
    color: #f87171; font-size: 0.75rem; font-weight: 800;
    cursor: pointer; transition: all var(--t);
  }
  :global(.topic-delete-btn:hover) { background: rgba(239,68,68,0.28); border-color: rgba(239,68,68,0.5); color: #fca5a5; }

  .grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1rem;
    width: 100%;
    max-width: 700px;
    padding: 0 1.5rem;
    box-sizing: border-box;
  }

  .card {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    padding: 1.75rem 1rem;
    border-radius: var(--r-lg);
    text-decoration: none;
    color: white;
    min-height: 130px;
    text-align: center;
    box-shadow: var(--sh-md);
    transition: transform var(--t), box-shadow var(--t);
    position: relative;
    overflow: hidden;
  }

  .card::after {
    content: '';
    position: absolute;
    inset: 0;
    background: rgba(255,255,255,0.1);
    opacity: 0;
    transition: opacity var(--t);
  }

  .card:hover::after { opacity: 1; }
  .card:hover { transform: translateY(-5px); box-shadow: var(--sh-lg); }
  .card:active { transform: translateY(-2px); }

  .card-icon { display: flex; align-items: center; justify-content: center; line-height: 1; }
  .card h2 { font-size: 1.15rem; font-weight: 800; letter-spacing: -0.01em; }
  .card p { font-size: 0.82rem; opacity: 0.88; font-weight: 500; }

  .card--purple  { background: linear-gradient(135deg, #00f0ff, #0099bb); }
  .card--pink    { background: linear-gradient(135deg, #f093fb, #c77dff); }
  .card--indigo  { background: linear-gradient(135deg, #4f46e5, #7c3aed); }
  .card--cyan    { background: linear-gradient(135deg, #00ffa3, #00cc85); }
  .card--green   { background: linear-gradient(135deg, #00ffa3, #00cc85); }
  .card--gold { background: linear-gradient(135deg, #f59e0b, #b45309); }
  .card--universe { background: linear-gradient(135deg, #0f1730, #1a2545); border: 1px solid rgba(0,240,255,0.15); position: relative; }

  .universe-badge {
    position: absolute;
    top: 0.6rem;
    right: 0.6rem;
    background: var(--cyan);
    color: var(--dark);
    font-size: 0.65rem;
    font-weight: 800;
    padding: 0.2rem 0.5rem;
    border-radius: 99px;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    max-width: 80px;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  @media (min-width: 600px) {
    .grid { grid-template-columns: repeat(3, 1fr); max-width: 860px; }
    h1 { font-size: 3rem; }
    .hero-icon { font-size: 4rem; }
    .card { min-height: 160px; padding: 2rem 1.5rem; }
    .card-icon { font-size: 2.8rem; }
    .card h2 { font-size: 1.25rem; }
    .card p { font-size: 0.9rem; }
    .navbar { padding-left: 1.75rem; padding-right: 1.75rem; }
    .navbar-name { display: block; font-size: 1.4rem; }
    .navbar-logo { height: 32px; }
    .topic-chip { flex: none; max-width: 220px; font-size: 0.85rem; justify-content: flex-start; }
  }

  @media (min-width: 1024px) {
    .page { gap: 2.5rem; }
    .grid { gap: 1.25rem; max-width: 960px; }
    .card { min-height: 180px; }
    .hero { padding-top: 2rem; }
  }
</style>

<script>
  import { getUniverseSession } from '../utils/supabase.ts';
  import { getActiveTopicLabel, getTopics, setActiveTopic } from '../utils/topics.ts';
  import { deleteLocalTopic } from '../utils/localTopics.ts';
  import { t } from '../i18n/index.ts';

  let topicModalEl: HTMLElement | null = null;

  function updateTopicBadge() {
    const { name, icon } = getActiveTopicLabel();
    const nameEl = document.getElementById('topicName');
    const iconEl = document.getElementById('topicIcon');
    if (nameEl) nameEl.textContent = name;
    if (iconEl) iconEl.textContent = icon;
  }

  async function openTopicModal() {
    if (topicModalEl) { topicModalEl.remove(); topicModalEl = null; }

    const backdrop = document.createElement('div');
    backdrop.className = 'topic-modal-backdrop';
    backdrop.innerHTML = `
      <div class="topic-modal">
        <div class="topic-modal-head">
          <h3>${t('topic.modal_title')}</h3>
          <a href="/new-topic" class="topic-modal-new">${t('topic.create_with_ai')}</a>
        </div>
        <div class="topic-list" id="topicList">
          <p class="topic-modal-loading">${t('topic.loading')}</p>
        </div>
        <button class="topic-modal-close" id="topicClose">${t('topic.close')}</button>
      </div>
    `;
    document.body.appendChild(backdrop);
    topicModalEl = backdrop;

    backdrop.addEventListener('click', e => { if (e.target === backdrop) closeTopicModal(); });
    document.getElementById('topicClose')!.onclick = closeTopicModal;

    try {
      const topics = await getTopics();
      const list   = document.getElementById('topicList') as HTMLElement;
      const active = localStorage.getItem('verbGame_activeTopic') ?? 'irregular-verbs';

      if (!topics.length) {
        list.innerHTML = `<p class="topic-modal-loading">${t('topic.empty')} <a href="/new-topic" style="color:#00f0ff">${t('topic.create_with_ai')} →</a></p>`;
        return;
      }

      const globalTopics = topics.filter(t => t.source !== 'local');
      const localTopics  = topics.filter(t => t.source === 'local');

      function topicBtn(topic: typeof topics[0]) {
        const deleteBtn = topic.source === 'local'
          ? `<button class="topic-delete-btn" data-delete="${topic.slug}" title="Eliminar tema" aria-label="Eliminar">✕</button>`
          : '';
        return `
          <div class="topic-row">
            <button class="topic-option ${topic.slug === active ? 'active' : ''}" data-slug="${topic.slug}">
              <span class="topic-icon">${topic.icon}</span>
              <span class="topic-info">
                <strong>${topic.name_es}</strong>
                <small>${topic.name_en}${topic.source === 'local' ? ` · ${t('topic.local_label')}` : ''}</small>
              </span>
            </button>
            ${deleteBtn}
          </div>`;
      }

      let html = globalTopics.map(topicBtn).join('');
      if (localTopics.length) {
        html += `<div class="topic-section-label">${t('topic.my_topics')}</div>`;
        html += localTopics.map(topicBtn).join('');
      }
      list.innerHTML = html;

      list.querySelectorAll<HTMLButtonElement>('.topic-option').forEach(btn => {
        btn.onclick = () => {
          const chosen = topics.find(t => t.slug === btn.dataset.slug)!;
          setActiveTopic(chosen);
          updateTopicBadge();
          closeTopicModal();
        };
      });

      list.querySelectorAll<HTMLButtonElement>('.topic-delete-btn').forEach(btn => {
        btn.onclick = (e) => {
          e.stopPropagation();
          const slug = btn.dataset.delete!;
          const topic = topics.find(t => t.slug === slug);
          if (!confirm(`¿Eliminar "${topic?.name_es ?? slug}"?`)) return;
          deleteLocalTopic(slug);
          const active = localStorage.getItem('verbGame_activeTopic');
          if (active === slug) localStorage.removeItem('verbGame_activeTopic');
          updateTopicBadge();
          openTopicModal();
        };
      });
    } catch {
      document.getElementById('topicList')!.innerHTML =
        `<p class="topic-modal-loading">${t('topic.error')}</p>`;
    }
  }

  function closeTopicModal() {
    topicModalEl?.remove();
    topicModalEl = null;
  }

  // ── PWA install ───────────────────────────────────────────────────────────────
  let deferredPrompt: any = null;
  const isStandalone = window.matchMedia('(display-mode: standalone)').matches
    || (navigator as any).standalone === true;

  if (!isStandalone) {
    const isIOS = /iphone|ipad|ipod/i.test(navigator.userAgent) && !(window as any).MSStream;

    if (isIOS) {
      // Show button immediately on iOS Safari
      const btn = document.getElementById('installBtn');
      if (btn) btn.style.display = 'inline-flex';
    } else {
      // Android/Chrome: wait for browser prompt
      window.addEventListener('beforeinstallprompt', (e: Event) => {
        e.preventDefault();
        deferredPrompt = e;
        const btn = document.getElementById('installBtn');
        if (btn) btn.style.display = 'inline-flex';
      });
    }
  }

  function initInstallBtn() {
    const btn = document.getElementById('installBtn');
    const sheet = document.getElementById('iosSheet');
    const sheetClose = document.getElementById('iosSheetClose');

    btn?.addEventListener('click', async () => {
      if (deferredPrompt) {
        deferredPrompt.prompt();
        const { outcome } = await deferredPrompt.userChoice;
        if (outcome === 'accepted') {
          btn.style.display = 'none';
        }
        deferredPrompt = null;
      } else if (sheet) {
        sheet.style.display = 'flex';
        sheet.setAttribute('aria-hidden', 'false');
      }
    });

    sheetClose?.addEventListener('click', () => {
      if (sheet) { sheet.style.display = 'none'; sheet.setAttribute('aria-hidden', 'true'); }
    });

    sheet?.addEventListener('click', (e) => {
      if (e.target === sheet) { sheet.style.display = 'none'; sheet.setAttribute('aria-hidden', 'true'); }
    });
  }

  function init() {
    const badge = document.getElementById('universeBadge') as HTMLElement | null;
    if (!badge) return; // not on home page

    const session = getUniverseSession();
    const card  = document.getElementById('universeCard') as HTMLAnchorElement;
    if (session) {
      badge.textContent = session.name;
      badge.style.display = 'block';
      card.href = `/universe/room?code=${session.code}`;
    } else {
      badge.style.display = 'none';
      card.href = '/universe';
    }

    updateTopicBadge();
    document.getElementById('topicChip')!.onclick = openTopicModal;
    initInstallBtn();

    // Triggered by Layout.astro after name is saved when no topic is set
    window.addEventListener('alunas:openTopicPicker', openTopicModal, { once: true });
  }

  document.addEventListener('astro:page-load', init);
  init();
</script>
