---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Irregular Verbs Game">
  <div class="page">
    <header class="page-header">
      <div class="logo" id="topicIcon">🎮</div>
      <h1 id="topicTitle">Irregular Verbs</h1>
      <p class="subtitle">Learn English the fun way</p>
      <button class="topic-chip" id="topicChip" title="Change topic">📚 <span id="topicName">Verbos Irregulares</span> ▾</button>
    </header>

    <main class="grid">
      <a href="/quick-match" class="card card--purple">
        <span class="card-icon">🎯</span>
        <h2>Quick Match</h2>
        <p>Multiple choice</p>
      </a>

      <a href="/speed-challenge" class="card card--pink">
        <span class="card-icon">⚡</span>
        <h2>Speed Challenge</h2>
        <p>Race the clock</p>
      </a>

      <a href="/type-master" class="card card--indigo">
        <span class="card-icon">⌨️</span>
        <h2>Type Master</h2>
        <p>Type the answer</p>
      </a>

      <a href="/memory-cards" class="card card--cyan">
        <span class="card-icon">🃏</span>
        <h2>Memory Cards</h2>
        <p>Find the pairs</p>
      </a>

      <a href="/practice" class="card card--green">
        <span class="card-icon">♾️</span>
        <h2>Practice</h2>
        <p>At your own pace</p>
      </a>

      <a href="/scores" class="card card--gold">
        <span class="card-icon">🏆</span>
        <h2>Records</h2>
        <p>Your best scores</p>
      </a>

      <a href="/universe" class="card card--universe" id="universeCard">
        <span class="card-icon">🌐</span>
        <h2>Universes</h2>
        <p>Compete with your class</p>
        <span class="universe-badge" id="universeBadge" style="display:none"></span>
      </a>
    </main>
  </div>
</Layout>

<style>
  .page {
    min-height: 100dvh;
    background: linear-gradient(145deg, #667eea 0%, #764ba2 100%);
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: calc(env(safe-area-inset-top) + 2rem) 1.5rem 5rem;
    gap: 2rem;
  }

  .page-header {
    text-align: center;
    color: white;
  }

  .logo {
    font-size: 3.5rem;
    line-height: 1;
    margin-bottom: 0.5rem;
  }

  h1 {
    font-size: 2.4rem;
    font-weight: 900;
    letter-spacing: -0.03em;
    text-shadow: 0 2px 12px rgba(0,0,0,0.2);
  }

  .subtitle {
    font-size: 1.05rem;
    opacity: 0.85;
    margin-top: 0.3rem;
    font-weight: 500;
  }

  .topic-chip {
    margin-top: 0.6rem;
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.35rem 0.9rem;
    background: rgba(255,255,255,0.18);
    border: 1.5px solid rgba(255,255,255,0.32);
    border-radius: 99px;
    color: white;
    font-family: var(--font);
    font-size: 0.82rem;
    font-weight: 700;
    cursor: pointer;
    transition: background var(--t), border-color var(--t);
    backdrop-filter: blur(8px);
  }
  .topic-chip:hover { background: rgba(255,255,255,0.28); border-color: rgba(255,255,255,0.55); }

  /* Topic picker modal */
  .topic-modal-backdrop {
    position: fixed; inset: 0; z-index: 200;
    background: rgba(15,12,41,0.72);
    backdrop-filter: blur(6px);
    display: flex; align-items: center; justify-content: center;
    padding: 1.5rem;
  }
  .topic-modal {
    background: white; border-radius: var(--r-xl);
    padding: 1.75rem 1.5rem 1.5rem;
    width: 100%; max-width: 420px;
    display: flex; flex-direction: column; gap: 1rem;
    box-shadow: var(--sh-lg);
  }
  .topic-modal h3 {
    font-size: 1.15rem; font-weight: 900; color: #1e1b4b; letter-spacing: -0.02em;
  }
  .topic-list { display: flex; flex-direction: column; gap: 0.5rem; }
  .topic-option {
    display: flex; align-items: center; gap: 0.85rem;
    padding: 0.9rem 1rem;
    border: 2px solid #e5e7eb; border-radius: var(--r-md);
    cursor: pointer; background: #f9fafb;
    transition: all var(--t); text-align: left;
    font-family: var(--font);
  }
  .topic-option:hover { border-color: #667eea; background: #f0f1ff; }
  .topic-option.active { border-color: #667eea; background: #eef2ff; }
  .topic-icon { font-size: 1.5rem; line-height: 1; }
  .topic-info strong { display: block; font-size: 0.95rem; font-weight: 800; color: #1e1b4b; }
  .topic-info small  { font-size: 0.78rem; color: #6b7280; }
  .topic-modal-close {
    align-self: flex-end; padding: 0.4rem 0.9rem;
    background: #f3f4f6; border: none; border-radius: var(--r-sm);
    font-family: var(--font); font-size: 0.85rem; font-weight: 700;
    color: #374151; cursor: pointer; transition: background var(--t);
  }
  .topic-modal-close:hover { background: #e5e7eb; }
  .topic-modal-loading { text-align: center; color: #9ca3af; font-size: 0.9rem; padding: 1rem 0; }

  .grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1rem;
    width: 100%;
    max-width: 700px;
  }

  .card {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    padding: 1.75rem 1rem;
    border-radius: var(--r-lg);
    text-decoration: none;
    color: white;
    min-height: 130px;
    text-align: center;
    box-shadow: var(--sh-md);
    transition: transform var(--t), box-shadow var(--t);
    position: relative;
    overflow: hidden;
  }

  .card::after {
    content: '';
    position: absolute;
    inset: 0;
    background: rgba(255,255,255,0.1);
    opacity: 0;
    transition: opacity var(--t);
  }

  .card:hover::after { opacity: 1; }
  .card:hover { transform: translateY(-5px); box-shadow: var(--sh-lg); }
  .card:active { transform: translateY(-2px); }

  .card-icon { font-size: 2.2rem; line-height: 1; }
  .card h2 { font-size: 1.15rem; font-weight: 800; letter-spacing: -0.01em; }
  .card p { font-size: 0.82rem; opacity: 0.88; font-weight: 500; }

  .card--purple  { background: linear-gradient(135deg, #667eea, #764ba2); }
  .card--pink    { background: linear-gradient(135deg, #f093fb, #f5576c); }
  .card--indigo  { background: linear-gradient(135deg, #4f46e5, #7c3aed); }
  .card--cyan    { background: linear-gradient(135deg, #06b6d4, #3b82f6); }
  .card--green   { background: linear-gradient(135deg, #10b981, #059669); }
  .card--gold { background: linear-gradient(135deg, #f59e0b, #b45309); }
  .card--universe { background: linear-gradient(135deg, #1e1b4b, #312e81); position: relative; }

  .universe-badge {
    position: absolute;
    top: 0.6rem;
    right: 0.6rem;
    background: #667eea;
    color: white;
    font-size: 0.65rem;
    font-weight: 800;
    padding: 0.2rem 0.5rem;
    border-radius: 99px;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    max-width: 80px;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  @media (min-width: 600px) {
    .grid { grid-template-columns: repeat(3, 1fr); max-width: 860px; }
    h1 { font-size: 3rem; }
    .logo { font-size: 4rem; }
    .card { min-height: 160px; padding: 2rem 1.5rem; }
    .card-icon { font-size: 2.8rem; }
    .card h2 { font-size: 1.25rem; }
    .card p { font-size: 0.9rem; }
  }

  @media (min-width: 1024px) {
    .page { padding: 2.5rem 2rem 5rem; gap: 2.5rem; }
    .grid { gap: 1.25rem; max-width: 960px; }
    .card { min-height: 180px; }
  }
</style>

<script>
  import { getUniverseSession } from '../utils/supabase.ts';
  import { getActiveTopicLabel, getTopics, setActiveTopic } from '../utils/topics.ts';

  let topicModalEl: HTMLElement | null = null;

  function updateTopicBadge() {
    const { name, icon } = getActiveTopicLabel();
    const nameEl = document.getElementById('topicName');
    const iconEl = document.getElementById('topicIcon');
    if (nameEl) nameEl.textContent = name;
    if (iconEl) iconEl.textContent = icon;
  }

  async function openTopicModal() {
    if (topicModalEl) { topicModalEl.remove(); topicModalEl = null; }

    const backdrop = document.createElement('div');
    backdrop.className = 'topic-modal-backdrop';
    backdrop.innerHTML = `
      <div class="topic-modal">
        <h3>¿Qué quieres aprender?</h3>
        <div class="topic-list" id="topicList">
          <p class="topic-modal-loading">Cargando temas…</p>
        </div>
        <button class="topic-modal-close" id="topicClose">Cerrar</button>
      </div>
    `;
    document.body.appendChild(backdrop);
    topicModalEl = backdrop;

    backdrop.addEventListener('click', e => { if (e.target === backdrop) closeTopicModal(); });
    document.getElementById('topicClose')!.onclick = closeTopicModal;

    try {
      const topics = await getTopics();
      const list   = document.getElementById('topicList') as HTMLElement;
      const active = localStorage.getItem('verbGame_activeTopic') ?? 'irregular-verbs';

      if (!topics.length) {
        list.innerHTML = '<p class="topic-modal-loading">No hay temas disponibles aún.</p>';
        return;
      }

      list.innerHTML = topics.map(t => `
        <button class="topic-option ${t.slug === active ? 'active' : ''}" data-slug="${t.slug}">
          <span class="topic-icon">${t.icon}</span>
          <span class="topic-info">
            <strong>${t.name_es}</strong>
            <small>${t.name_en}</small>
          </span>
        </button>
      `).join('');

      list.querySelectorAll<HTMLButtonElement>('.topic-option').forEach(btn => {
        btn.onclick = () => {
          const chosen = topics.find(t => t.slug === btn.dataset.slug)!;
          setActiveTopic(chosen);
          updateTopicBadge();
          closeTopicModal();
        };
      });
    } catch {
      document.getElementById('topicList')!.innerHTML =
        '<p class="topic-modal-loading">Error al cargar temas.</p>';
    }
  }

  function closeTopicModal() {
    topicModalEl?.remove();
    topicModalEl = null;
  }

  function init() {
    const session = getUniverseSession();
    const badge = document.getElementById('universeBadge') as HTMLElement;
    const card  = document.getElementById('universeCard') as HTMLAnchorElement;
    if (session) {
      badge.textContent = session.name;
      badge.style.display = 'block';
      card.href = `/universe/room?code=${session.code}`;
    } else {
      badge.style.display = 'none';
      card.href = '/universe';
    }

    updateTopicBadge();
    document.getElementById('topicChip')!.onclick = openTopicModal;
  }

  document.addEventListener('astro:page-load', init);
  init();
</script>
